node_modules/
dist/
docs/api/
coverage/
*.tsbuildinfo
.eslintcache

# `npm pack` writes <name>-<version>.tgz into the repository root, which the
# release procedure asks you to build and read rather than keep. A build
# product like dist/, and never something this repository tracks.
*.tgz

# examples/package.json keeps @noble/curves out of the library's own dependency
# tree, so the signature-verification example needs its own install.
examples/node_modules/
examples/package-lock.json

# Fetched by `npm run fetch:spec` from the whitepaper repository, the same way
# dist/ is produced by a build. tests/registry/specification.test.ts compares
# the unit registry against it entry by entry where it is present, and skips
# where it is not.
spec/

# Editors
.idea/
*.swp
.DS_Store

# Logs
npm-debug.log*
*.log

# Local environment
.env
.env.*
!.env.example
