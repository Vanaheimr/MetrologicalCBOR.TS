{
  "$schema": "https://typedoc.org/schema.json",

  "entryPoints":        ["src/index.ts"],
  "tsconfig":           "tsconfig.build.json",
  "out":                "docs/api",

  "name":               "Metrological CBOR",
  "readme":             "README.md",
  "includeVersion":     true,

  "githubPages":        false,
  "hideGenerator":      true,
  "excludePrivate":     true,
  "excludeInternal":    true,
  "excludeExternals":   true,

  "categorizeByGroup":  true,
  "sort":               ["source-order"],

  "navigationLinks": {
    "Conformance":  "https://github.com/Vanaheimr/MetrologicalCBOR.TS/blob/master/docs/conformance.md",
    "Text format":  "https://github.com/Vanaheimr/MetrologicalCBOR.TS/blob/master/docs/text-format.md",
    "Repository":   "https://github.com/Vanaheimr/MetrologicalCBOR.TS"
  },

  "validation": {
    "notExported":     true,
    "invalidLink":     true,
    "notDocumented":   false
  },

  "treatValidationWarningsAsErrors": true
}
